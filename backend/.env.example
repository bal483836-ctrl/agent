# ===== 服务 =====
PORT=8080
NODE_ENV=development

# ===== 鉴权 =====
# 用于签发 JWT 的密钥，**生产必须改**
JWT_SECRET=change-me-in-production

# ===== LLM =====
# 供应商：openai（OpenAI 兼容协议，含 DeepSeek/Kimi/Qwen 等）| anthropic
LLM_PROVIDER=openai

# 通用 API key（推荐使用）
LLM_API_KEY=

# 通用模型 id
#   DeepSeek：deepseek-chat / deepseek-reasoner
#   OpenAI： gpt-4o-mini / gpt-4o
#   Claude： claude-sonnet-4-6
LLM_MODEL=deepseek-chat

# 通用 base URL；不填走 provider 默认
#   DeepSeek：https://api.deepseek.com（不填即默认）
#   OpenAI： https://api.openai.com/v1
LLM_BASE_URL=

# ---- 兼容性环境变量（任选一组填写即可）----
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ===== 数据 =====
# 每个组织的数据根目录：DATA_DIR/<orgId>/<userId>/...
DATA_DIR=./data

# Skills 目录：每个子目录是一个 skill，含 manifest.json + main.py
SKILLS_DIR=./skills

# ===== 上传限制 =====
MAX_FILE_BYTES=524288000      # 500 MB
MAX_TOTAL_BYTES=2147483648    # 2 GB
MAX_FILES_PER_BATCH=200

# ===== 调试用户（仅 dev） =====
# 跳过真实账号系统，直接签发 token 给这个组织/用户
DEV_DEFAULT_ORG=org-xiehe
DEV_DEFAULT_USER=u-001
DEV_DEFAULT_NAME=张研究员
DEV_DEFAULT_EMAIL=zhang.researcher@example.com
DEV_DEFAULT_ROLE=主要研究员（PI）
DEV_DEFAULT_ORG_NAME=协和疫苗研究中心
