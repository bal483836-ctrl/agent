# ====== 前端运行时配置 ======

# 是否使用本地 mock 数据。
#   true  → 完全离线，演示模式
#   false → 调用真实后端（默认，配合 backend/）
VITE_USE_MOCK=false

# REST API 基础路径（dev 期由 vite proxy 转发到 VITE_DEV_BACKEND）
VITE_API_BASE_URL=/api

# WebSocket 基础路径（留空时自动用当前 host 拼接）
VITE_WS_BASE_URL=

# ====== Dev only ======

# 开发时 vite proxy 转发到的后端地址
VITE_DEV_BACKEND=http://localhost:8080
