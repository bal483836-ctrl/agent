# ====== 前端运行时配置 ======
#
# 这是接同事 OpenClaw 后端的分支，默认 external 模式。
# 不显式设 VITE_BACKEND_MODE 也会走 external（因为本分支 env.ts 的默认值改了）。

# 后端模式：
#   mock     完全离线演示
#   local    本仓库 backend/ 的 Fastify 服务
#   external 同事的 OpenClaw 后端 ← 本分支默认
VITE_BACKEND_MODE=external

# ---- external 模式（默认） ----
# 浏览器调用前缀（vite proxy 会剥掉 /ext 转发）
VITE_EXTERNAL_API_BASE=/ext
# Dev 期 vite proxy 转发的真实后端
VITE_EXTERNAL_DEV_BACKEND=http://47.116.192.78:8080
# 默认身份（接口要求 userID 参数）
VITE_EXTERNAL_USER_ID=林轩辉
VITE_EXTERNAL_USER_DEPT=质量管理部

# ---- mock / local 模式（备用） ----
# VITE_USE_MOCK=false
# VITE_API_BASE_URL=/api
# VITE_WS_BASE_URL=
# VITE_DEV_BACKEND=http://localhost:8080
